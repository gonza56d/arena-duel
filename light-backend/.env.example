# Copy to .env and adjust. The server reads these from the environment.

# HTTP port the service listens on.
PORT=8080

# MongoDB connection string and database name.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=arena_duel

# Secret used to sign bearer tokens (HS256). REQUIRED — the server refuses to
# start without it. Use a long random value; never commit the real secret.
JWT_SECRET=change-me-to-a-long-random-string
